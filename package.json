{
  "name": "capacitor-launchdarkly",
  "version": "0.1.2",
  "description": "LaunchDarkly feature flags for Capacitor apps through the native iOS and Android client SDKs, started natively at app launch",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "ios/Tests",
    "Package.swift",
    "CapacitorLaunchdarkly.podspec",
    "LICENSE"
  ],
  "author": "Maxim Belov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximBelov/capacitor-launchdarkly.git"
  },
  "bugs": {
    "url": "https://github.com/MaximBelov/capacitor-launchdarkly/issues"
  },
  "homepage": "https://github.com/MaximBelov/capacitor-launchdarkly#readme",
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "launchdarkly",
    "feature flags",
    "feature toggles",
    "flags",
    "ios",
    "android"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "xcodebuild build -scheme CapacitorLaunchdarkly -destination generic/platform=iOS -derivedDataPath build/ios-device",
    "verify:android": "cd android && ./gradlew clean build test",
    "verify:web": "npm run build",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "eslint": "eslint",
    "prettier": "prettier \"**/*.{css,html,ts,js,mjs,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api LaunchDarklyPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:parity": "node --test test/unit/platform-parity.test.mjs",
    "test:android": "cd android && ./gradlew test",
    "test:ios": "./scripts/test-ios.sh",
    "example:install": "cd example-app && npm install --no-audit --no-fund",
    "example:android:build": "npm run example:install && cd example-app && npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "example:ios:build": "npm run example:install && cd example-app && npm run build && npx cap sync ios && xcodebuild build -project ios/App/App.xcodeproj -scheme App -destination generic/platform=iOS\\ Simulator -derivedDataPath ../build/example-ios CODE_SIGNING_ALLOWED=NO"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.6.2",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "@launchdarkly/js-client-sdk": "^4.14.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "prettier-plugin-java": "^2.12.0",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.3",
    "swiftlint": "^2.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0",
    "@launchdarkly/js-client-sdk": ">=4.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependenciesMeta": {
    "@launchdarkly/js-client-sdk": {
      "optional": true
    }
  }
}
